<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AbayPOS.Data</RootNamespace>
    <Description>SQLite data access. Swap IDbConnectionFactory later for MySQL 8.4.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AbayPOS.Domain\AbayPOS.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\database\schema.sql" Link="Schema\schema.sql" />
    <EmbeddedResource Include="..\database\seed.sql" Link="Schema\seed.sql" />
  </ItemGroup>
</Project>
